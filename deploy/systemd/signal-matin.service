[Unit]
Description=Signal Matin - génération de l'édition du jour
Wants=network-online.target
After=network-online.target docker.service
Requires=docker.service

[Service]
Type=oneshot
WorkingDirectory=/opt/signal-matin
# Un nettoyage « docker image prune -a » peut supprimer l'image entre deux
# matins : on la reconstruit si besoin (premier téléchargement : quelques minutes).
TimeoutStartSec=30min
ExecStartPre=/bin/sh -c 'docker image inspect signal-matin:latest >/dev/null 2>&1 || docker build -t signal-matin:latest /opt/signal-matin/app'
ExecStart=/usr/bin/docker run --rm --name signal-matin \
  -v /opt/signal-matin/config.yaml:/app/config.yaml:ro \
  -v /opt/signal-matin/.env:/app/.env:ro \
  -v /opt/signal-matin/output:/app/output \
  -v /opt/signal-matin/secrets:/app/secrets \
  signal-matin:latest generate --email
